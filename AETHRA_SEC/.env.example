# AETHRA-SEC environment configuration template.
# Copy this file to ".env" and adjust the values for your laboratory machine.
# The .env file is intentionally excluded from version control (see .gitignore)
# so database credentials never end up inside the repository.

# ---- Database (MySQL) ----
AETHRA_DB_HOST=localhost
AETHRA_DB_PORT=3306
AETHRA_DB_NAME=aethra_sec
AETHRA_DB_USER=aethra_app
AETHRA_DB_PASSWORD=change_me_in_production

# ---- Integration tool paths (Windows examples) ----
# Nmap executable (python-nmap searches PATH by default; override if needed).
AETHRA_NMAP_PATH=nmap
# Snort installation directory and the alert socket AETHRA-SEC listens on.
AETHRA_SNORT_DIR=C:\Snort
AETHRA_SNORT_EXE=C:\Snort\bin\snort.exe
AETHRA_SNORT_CONF=C:\Snort\etc\snort.conf
AETHRA_SNORT_RULES=C:\Snort\rules
# Alert Socket IPC endpoint. On Windows this is a TCP loopback host:port.
AETHRA_SNORT_ALERT_HOST=127.0.0.1
AETHRA_SNORT_ALERT_PORT=9000

# ---- Monitoring ----
# Capture interface name as reported by tshark -D (leave blank to auto-select).
AETHRA_CAPTURE_INTERFACE=

# ---- Application ----
AETHRA_THEME=darkly
AETHRA_REFRESH_INTERVAL_MS=1000
AETHRA_REPORT_DIR=reports_output
